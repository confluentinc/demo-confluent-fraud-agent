# Copied to credentials.env (gitignored) by `uv run deploy`, which prompts for
# anything missing and saves it here. Never commit credentials.env.

# Confluent Cloud login, used to auto-login the Confluent CLI (optional; skip for SSO).
CONFLUENT_EMAIL=
CONFLUENT_PASSWORD=

# Confluent Cloud "Cloud resource management" API key (deploy can generate one).
TF_VAR_confluent_cloud_api_key=
TF_VAR_confluent_cloud_api_secret=

# What backs the agent's model: confluent = CSP Hosted inference (default, no AWS
# keys); bedrock = your own AWS Bedrock keys below (same as `uv run deploy --bedrock`).
TF_VAR_llm_provider=confluent

# bedrock only: AWS credentials allowed to invoke Claude on Amazon Bedrock in us-east-1.
# `uv run api-keys create` mints a scoped IAM user key for workshops.
TF_VAR_aws_bedrock_access_key=
TF_VAR_aws_bedrock_secret_key=
# Only for temporary (ASIA...) credentials.
TF_VAR_aws_session_token=

# false = workshop mode (same as `uv run deploy --workshop`).
TF_VAR_deploy_flink_pipeline=true
